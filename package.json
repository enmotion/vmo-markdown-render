{
  "name": "vmo-markdown-render",
  "version": "0.0.2",
  "type": "module",
  "private": false,
  "description": "markdown,llm chat,render",
  "main": "./dist/vmo-markdown-render.cjs",
  "module": "./dist/vmo-markdown-render.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vmo-markdown-render.js",
      "require": "./dist/vmo-markdown-render.cjs"
    },
    "./*": "./*",
    "./style.css": "./dist/style.css",
    "./math.css": "./dist/math.css"
  },
  "files": [
    "README.en.md",
    "dist",
    "docs/*.md",
    "docs/api/*.md",
    "docs/guide/*.md",
    "docs/en/**/*.md",
    "docs/public/prompts/*.md",
    "docs/examples"
  ],
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build": "vue-tsc && vite build && node scripts/copy-math-assets.mjs",
    "preview": "vite preview",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:coverage:input": "vitest run test/input --coverage --coverage.include=components/markdown-input/**",
    "test:types": "vue-tsc --noEmit -p tsconfig.type-tests.json",
    "docs:check": "vue-tsc --noEmit -p tsconfig.docs-examples.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^20.10.4",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.16",
    "happy-dom": "^21.0.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.4",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.5",
    "vue-tsc": "^1.8.22"
  },
  "dependencies": {
    "@markmend/core": "^2.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
